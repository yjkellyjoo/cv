---
/**
 * A single pill for one entry of a `stacks` or `topics` array — the named
 * technologies a project or role used, versus the conceptual tags it carries.
 *
 * Both kinds render as pills; `kind` is the only thing that tells them apart.
 * `stack` pills are monospace, per the design direction that reserves
 * monospace for stack pills and inline code. `topic` pills stay in the sans
 * stack with a dashed border, so a list mixing both reads at a glance which
 * are named tools and which are descriptive tags.
 *
 * `data-value` carries the raw value the pill was built from, untouched by
 * any display transform on `label`. The stack filter (task 5) matches
 * against this attribute rather than rendered text, per that task's standing
 * ruling — text is presentation and can be styled, truncated, or reordered,
 * an attribute is a contract. Defaults to `label` when the two are the same.
 */
interface Props {
	label: string;
	kind?: 'stack' | 'topic';
	value?: string;
}

const { label, kind = 'stack', value = label } = Astro.props;
---

<span class:list={['pill', kind === 'topic' && 'pill--topic']} data-value={value}>{label}</span>

<style>
	.pill {
		display: inline-flex;
		align-items: center;
		border-radius: var(--radius-pill);
		border: var(--border-width) solid var(--border);
		background-color: var(--bg-subtle);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		line-height: 1;
		padding-block: var(--space-3xs);
		padding-inline: var(--space-2xs);
	}

	.pill--topic {
		background-color: transparent;
		border-style: dashed;
		color: var(--text-faint);
		font-family: var(--font-sans);
		font-weight: var(--weight-medium);
	}
</style>
